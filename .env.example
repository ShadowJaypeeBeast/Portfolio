# Copy this file to .env and fill in real values before running the site.

# The username and password you'll use to log into /admin.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# A long random string used to sign login sessions. Change this to anything —
# mash the keyboard for 40 characters. It just needs to be unpredictable.
SESSION_SECRET=change-this-to-a-long-random-string

# Optional — two-factor login. Leave this blank/unset and login works with
# just the username/password above. To turn on 2FA, run:
#   node scripts/generate-2fa-secret.js
# scan the QR code it prints with your authenticator app, then paste the
# secret it gives you here and restart the server.
ADMIN_TOTP_SECRET=

PORT=3000
